<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 잠들었다 정해진 시각에 깨우기: wake lock, 알람, 시스템 화면 꺼짐 시간 변경(사용자가 '시스템 설정 수정'을 허용해야 함) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- USB 로 Download 폴더에 넣은 연결 파일(dashboard.txt)을 읽기 위해. Poke3 는 안드로이드 10 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Dashboard"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">

        <!--
          HOME 카테고리: 이 앱을 기본 홈 화면(런처)으로 고르면
          전원을 켜거나 홈 버튼을 눌러도 항상 대시보드가 뜬다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 알람으로 화면을 잠깐 켜서 다시 그리게 한다 -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="false" />
    </application>
</manifest>
